generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MemoryType {
  PREFERENCE
  FACT
  INTEREST
  ROUTINE
  INSTRUCTION
}

enum PendingActionStatus {
  PENDING
  CONFIRMED
  EXECUTING
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

model EcosystemUser {
  id               String          @id @default(uuid()) @db.Uuid
  authSubject      String          @unique @map("auth_subject")
  email            String?
  displayName      String?         @map("display_name")
  avatarUrl        String?         @map("avatar_url")
  locale           String?
  timezone         String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  conversations    Conversation[]
  memories         Memory[]
  pendingActions   PendingAction[]
  auditEvents      AuditEvent[]

  @@index([email])
  @@map("ecosystem_users")
}

model Conversation {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  title       String?
  status      ConversationStatus @default(ACTIVE)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  user        EcosystemUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  pendingActions PendingAction[]

  @@index([userId, updatedAt])
  @@index([userId, status, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  provider       String?
  model          String?
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Memory {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  type       MemoryType
  key        String
  value      String
  source     String?
  confidence Float?
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  user       EcosystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, key])
  @@index([userId, type])
  @@map("memories")
}

model PendingAction {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  interactionId  String              @map("interaction_id")
  callId         String              @map("call_id")
  toolName       String              @map("tool_name")
  arguments      Json
  status         PendingActionStatus @default(PENDING)
  expiresAt      DateTime            @map("expires_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  confirmedAt    DateTime?            @map("confirmed_at")
  user           EcosystemUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@index([conversationId, status])
  @@map("pending_actions")
}

model AuditEvent {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String?        @map("user_id") @db.Uuid
  correlationId  String?        @map("correlation_id")
  eventType      String         @map("event_type")
  action         String
  resourceType   String?        @map("resource_type")
  resourceId     String?        @map("resource_id")
  status         String
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")
  user           EcosystemUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([correlationId])
  @@map("audit_events")
}
