generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MemoryType {
  PREFERENCE
  FACT
  INTEREST
  ROUTINE
  INSTRUCTION
}

enum PendingActionStatus {
  PENDING
  CONFIRMED
  EXECUTING
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

model EcosystemUser {
  id               String          @id @default(uuid()) @db.Uuid
  authSubject      String          @unique @map("auth_subject")
  email            String?
  displayName      String?         @map("display_name")
  avatarUrl        String?         @map("avatar_url")
  locale           String?
  timezone         String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  conversations    Conversation[]
  memories         Memory[]
  pendingActions   PendingAction[]
  auditEvents      AuditEvent[]
  cloudFiles       CloudFile[]
  devices          Device[]
  deviceSessions   DeviceSession[]
  events           MaxEvent[]
  profiles         Profile[]
  mediaStates      MediaState[]

  @@index([email])
  @@map("ecosystem_users")
}

model Conversation {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  title       String?
  status      ConversationStatus @default(ACTIVE)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  user        EcosystemUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  pendingActions PendingAction[]

  @@index([userId, updatedAt])
  @@index([userId, status, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  provider       String?
  model          String?
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Memory {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  type       MemoryType
  key        String
  value      String
  source     String?
  confidence Float?
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  user       EcosystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, key])
  @@index([userId, type])
  @@map("memories")
}

model PendingAction {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  interactionId  String              @map("interaction_id")
  callId         String              @map("call_id")
  toolName       String              @map("tool_name")
  arguments      Json
  status         PendingActionStatus @default(PENDING)
  expiresAt      DateTime            @map("expires_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  confirmedAt    DateTime?            @map("confirmed_at")
  user           EcosystemUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@index([conversationId, status])
  @@map("pending_actions")
}

model AuditEvent {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String?        @map("user_id") @db.Uuid
  correlationId  String?        @map("correlation_id")
  eventType      String         @map("event_type")
  action         String
  resourceType   String?        @map("resource_type")
  resourceId     String?        @map("resource_id")
  status         String
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")
  user           EcosystemUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([correlationId])
  @@map("audit_events")
}

model CloudFile {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  originalName String       @map("original_name")
  storageKey  String        @unique @map("storage_key")
  mimeType    String        @map("mime_type")
  sizeBytes   BigInt        @map("size_bytes")
  sha256      String        @db.VarChar(64)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  user        EcosystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("cloud_files")
}


enum DeviceType {
  MOBILE
  TABLET
  TV
  DESKTOP
  SPEAKER
  CAR
  OTHER
}

enum DeviceSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum MaxEventType {
  ANNOUNCEMENT
  BROADCAST
  SECURITY_ALERT
  COMMAND
  MEDIA_ACTION
  NOTIFICATION
  AUTOMATION_EVENT
  DEVICE_CHANGED
  ACCOUNT_UPDATED
  SUBSCRIPTION_UPDATED
}

enum EventPriority {
  INFO
  NORMAL
  IMPORTANT
  CRITICAL
}

model Device {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  externalId     String?         @map("external_id")
  deviceType     DeviceType      @map("device_type")
  platform       String
  deviceName     String          @map("device_name")
  manufacturer   String?
  model          String?
  osVersion      String?         @map("os_version")
  appVersion     String?         @map("app_version")
  capabilities   Json?
  timezone       String?
  language       String?
  homeId         String?         @map("home_id")
  roomId         String?         @map("room_id")
  revokedAt      DateTime?       @map("revoked_at")
  lastSeenAt     DateTime?       @map("last_seen_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  user           EcosystemUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions       DeviceSession[]
  events         MaxEvent[]      @relation("DeviceEvents")
  mediaStates    MediaState[]

  @@unique([userId, externalId])
  @@index([userId, deviceType])
  @@index([homeId, roomId])
  @@index([lastSeenAt])
  @@map("devices")
}

model DeviceSession {
  id          String              @id @default(uuid()) @db.Uuid
  deviceId    String              @map("device_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  profileId   String?             @map("profile_id") @db.Uuid
  status      DeviceSessionStatus @default(ACTIVE)
  sessionKey  String?             @unique @map("session_key")
  metadata    Json?
  createdAt   DateTime            @default(now()) @map("created_at")
  lastSeenAt  DateTime            @default(now()) @map("last_seen_at")
  expiresAt   DateTime?           @map("expires_at")
  device      Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user        EcosystemUser       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([deviceId, status])
  @@map("device_sessions")
}

model MaxEvent {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  deviceId       String?       @map("device_id") @db.Uuid
  homeId         String?       @map("home_id")
  roomId         String?       @map("room_id")
  eventType      MaxEventType  @map("event_type")
  priority       EventPriority @default(NORMAL)
  payload        Json
  targetType     String?       @map("target_type")
  targetId       String?       @map("target_id")
  deliveredAt    DateTime?     @map("delivered_at")
  expiresAt      DateTime?     @map("expires_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  user           EcosystemUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  device         Device?       @relation("DeviceEvents", fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
  @@index([homeId, createdAt])
  @@index([eventType, createdAt])
  @@map("max_events")
}

model Profile {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  name        String
  profileType String        @map("profile_type")
  avatarUrl   String?       @map("avatar_url")
  permissions Json?
  settings    Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  user        EcosystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profiles")
}

model MediaState {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  contentId      String        @map("content_id")
  contentType    String        @map("content_type")
  title          String?
  positionMs     Int           @default(0) @map("position_ms")
  durationMs     Int?          @map("duration_ms")
  sourceDeviceId String?       @map("source_device_id") @db.Uuid
  updatedAt      DateTime      @updatedAt @map("updated_at")
  user           EcosystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDevice   Device?       @relation(fields: [sourceDeviceId], references: [id], onDelete: SetNull)

  @@unique([userId, contentId])
  @@index([userId, updatedAt])
  @@map("media_states")
}
