generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["max_backend"]
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  @@schema("max_backend")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
  @@schema("max_backend")
}

enum MemoryType {
  PREFERENCE
  FACT
  INTEREST
  ROUTINE
  INSTRUCTION
  @@schema("max_backend")
}

enum PendingActionStatus {
  PENDING
  CONFIRMED
  EXECUTING
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
  @@schema("max_backend")
}

model EcosystemUser {
  id               String          @id @default(uuid()) @db.Uuid
  authSubject      String          @unique @map("auth_subject")
  email            String?
  displayName      String?         @map("display_name")
  avatarUrl        String?         @map("avatar_url")
  locale           String?
  timezone         String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  conversations    Conversation[]
  memories         Memory[]
  pendingActions   PendingAction[]
  auditEvents      AuditEvent[]
  cloudFiles       CloudFile[]
  devices          Device[]
  deviceSessions   DeviceSession[]
  events           MaxEvent[]
  profiles         Profile[]
  mediaStates      MediaState[]
  ownedHomes       Home[] @relation("HomeOwner")
  homeMemberships  HomeMember[]

  @@index([email])
  @@map("ecosystem_users")
  @@schema("max_backend")
}

model Conversation {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  title       String?
  status      ConversationStatus @default(ACTIVE)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  user        EcosystemUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  pendingActions PendingAction[]

  @@index([userId, updatedAt])
  @@index([userId, status, updatedAt])
  @@map("conversations")
  @@schema("max_backend")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  provider       String?
  model          String?
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
  @@schema("max_backend")
}

model Memory {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  type       MemoryType
  key        String
  value      String
  source        String?
  productSource String?   @map("product_source")
  confidence    Float?
  importance    Float     @default(0.5)
  isExplicit    Boolean   @default(false) @map("is_explicit")
  expiresAt     DateTime? @map("expires_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  user       EcosystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, key])
  @@index([userId, type])
  @@map("memories")
  @@schema("max_backend")
}

model PendingAction {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  interactionId  String              @map("interaction_id")
  callId         String              @map("call_id")
  toolName       String              @map("tool_name")
  arguments      Json
  status         PendingActionStatus @default(PENDING)
  expiresAt      DateTime            @map("expires_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  confirmedAt    DateTime?            @map("confirmed_at")
  user           EcosystemUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@index([conversationId, status])
  @@map("pending_actions")
  @@schema("max_backend")
}

model AuditEvent {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String?        @map("user_id") @db.Uuid
  correlationId  String?        @map("correlation_id")
  eventType      String         @map("event_type")
  action         String
  resourceType   String?        @map("resource_type")
  resourceId     String?        @map("resource_id")
  status         String
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")
  user           EcosystemUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([correlationId])
  @@map("audit_events")
  @@schema("max_backend")
}

model CloudFile {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  originalName String       @map("original_name")
  storageKey  String        @unique @map("storage_key")
  mimeType    String        @map("mime_type")
  sizeBytes   BigInt        @map("size_bytes")
  sha256      String        @db.VarChar(64)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  user        EcosystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("cloud_files")
  @@schema("max_backend")
}


enum DeviceType {
  MOBILE
  TABLET
  TV
  DESKTOP
  SPEAKER
  CAR
  OTHER
  @@schema("max_backend")
}

enum DeviceSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  @@schema("max_backend")
}

enum MaxEventType {
  ANNOUNCEMENT
  BROADCAST
  SECURITY_ALERT
  COMMAND
  MEDIA_ACTION
  NOTIFICATION
  AUTOMATION_EVENT
  DEVICE_CHANGED
  ACCOUNT_UPDATED
  SUBSCRIPTION_UPDATED
  @@schema("max_backend")
}

enum EventPriority {
  INFO
  NORMAL
  IMPORTANT
  CRITICAL
  @@schema("max_backend")
}

model Device {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  externalId     String?         @map("external_id")
  deviceType     DeviceType      @map("device_type")
  platform       String
  deviceName     String          @map("device_name")
  manufacturer   String?
  model          String?
  osVersion      String?         @map("os_version")
  appVersion     String?         @map("app_version")
  capabilities   Json?
  timezone       String?
  language       String?
  homeId         String?         @map("home_id")
  roomId         String?         @map("room_id")
  revokedAt      DateTime?       @map("revoked_at")
  lastSeenAt     DateTime?       @map("last_seen_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  user           EcosystemUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions       DeviceSession[]
  events         MaxEvent[]      @relation("DeviceEvents")
  mediaStates    MediaState[]

  @@unique([userId, externalId])
  @@index([userId, deviceType])
  @@index([homeId, roomId])
  @@index([lastSeenAt])
  @@map("devices")
  @@schema("max_backend")
}

model DeviceSession {
  id          String              @id @default(uuid()) @db.Uuid
  deviceId    String              @map("device_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  profileId   String?             @map("profile_id") @db.Uuid
  status      DeviceSessionStatus @default(ACTIVE)
  sessionKey  String?             @unique @map("session_key")
  metadata    Json?
  createdAt   DateTime            @default(now()) @map("created_at")
  lastSeenAt  DateTime            @default(now()) @map("last_seen_at")
  expiresAt   DateTime?           @map("expires_at")
  device      Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user        EcosystemUser       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([deviceId, status])
  @@map("device_sessions")
  @@schema("max_backend")
}

model MaxEvent {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  deviceId       String?       @map("device_id") @db.Uuid
  homeId         String?       @map("home_id")
  roomId         String?       @map("room_id")
  eventType      MaxEventType  @map("event_type")
  priority       EventPriority @default(NORMAL)
  payload        Json
  targetType     String?       @map("target_type")
  targetId       String?       @map("target_id")
  deliveredAt    DateTime?     @map("delivered_at")
  expiresAt      DateTime?     @map("expires_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  user           EcosystemUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  device         Device?       @relation("DeviceEvents", fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
  @@index([homeId, createdAt])
  @@index([eventType, createdAt])
  @@map("max_events")
  @@schema("max_backend")
}

model Profile {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  name        String
  profileType String        @map("profile_type")
  avatarUrl   String?       @map("avatar_url")
  permissions Json?
  settings    Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  user        EcosystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profiles")
  @@schema("max_backend")
}

model MediaState {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  contentId      String        @map("content_id")
  contentType    String        @map("content_type")
  title          String?
  positionMs     Int           @default(0) @map("position_ms")
  durationMs     Int?          @map("duration_ms")
  sourceDeviceId String?       @map("source_device_id") @db.Uuid
  updatedAt      DateTime      @updatedAt @map("updated_at")
  user           EcosystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDevice   Device?       @relation(fields: [sourceDeviceId], references: [id], onDelete: SetNull)

  @@unique([userId, contentId])
  @@index([userId, updatedAt])
  @@map("media_states")
  @@schema("max_backend")
}


enum HomeMemberRole {
  OWNER
  ADMIN
  MEMBER
  CHILD
  GUEST
  SUPPORT
  @@schema("max_backend")
}

enum HomeModeType {
  STUDY
  WORSHIP
  VISITOR
  DINNER
  FAMILY_TIME
  SLEEP
  MOVIE
  TRAVEL
  CLEANING
  EMERGENCY
  CUSTOM
  @@schema("max_backend")
}

enum AutomationStatus {
  ENABLED
  PAUSED
  DISABLED
  FAILED
  @@schema("max_backend")
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
  @@schema("max_backend")
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
  ACKNOWLEDGED
  @@schema("max_backend")
}

model Home {
  id                String             @id @default(uuid()) @db.Uuid
  ownerId           String             @map("owner_id") @db.Uuid
  name              String
  timezone          String?
  latitude          Float?
  longitude         Float?
  settings          Json?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  owner             EcosystemUser      @relation("HomeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members           HomeMember[]
  rooms             HomeRoom[]
  modes             HomeMode[]
  automations       HomeAutomation[]
  scenes            HomeScene[]
  notifications     HomeNotification[]
  accessGrants      HomeAccessGrant[]
  incidents         HomeIncident[]
  locations         HomeLocation[]
  integrations      HomeIntegration[]
  healthIssues      HomeHealthIssue[]
  energyReadings    HomeEnergyReading[]
  tasks             HomeTask[]
  calendarEvents    HomeCalendarEvent[]
  payments          HomePayment[]
  subscriptions     HomeSubscription[]
  geofences         HomeGeofence[]
  @@index([ownerId])
  @@map("homes")
  @@schema("max_backend")
}

model HomeMember {
  id          String          @id @default(uuid()) @db.Uuid
  homeId      String          @map("home_id") @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  role        HomeMemberRole
  permissions Json?
  privacy     Json?
  joinedAt    DateTime        @default(now()) @map("joined_at")
  home        Home             @relation(fields: [homeId], references: [id], onDelete: Cascade)
  user        EcosystemUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([homeId, userId])
  @@index([userId])
  @@map("home_members")
  @@schema("max_backend")
}

model HomeRoom {
  id          String       @id @default(uuid()) @db.Uuid
  homeId      String       @map("home_id") @db.Uuid
  name        String
  settings    Json?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  home        Home         @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@unique([homeId, name])
  @@map("home_rooms")
  @@schema("max_backend")
}

model HomeMode {
  id          String        @id @default(uuid()) @db.Uuid
  homeId      String        @map("home_id") @db.Uuid
  type        HomeModeType
  name        String
  enabled     Boolean       @default(false)
  config      Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  home        Home          @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@unique([homeId, type, name])
  @@index([homeId, enabled])
  @@map("home_modes")
  @@schema("max_backend")
}

model HomeAutomation {
  id             String           @id @default(uuid()) @db.Uuid
  homeId         String           @map("home_id") @db.Uuid
  name           String
  status         AutomationStatus @default(ENABLED)
  triggers       Json
  conditions     Json?
  actions        Json
  schedule       Json?
  lastRunAt      DateTime?        @map("last_run_at")
  lastResult     Json?            @map("last_result")
  failureCount   Int              @default(0) @map("failure_count")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  home           Home             @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@index([homeId, status])
  @@map("home_automations")
  @@schema("max_backend")
}

model HomeScene {
  id          String   @id @default(uuid()) @db.Uuid
  homeId      String   @map("home_id") @db.Uuid
  name        String
  actions     Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  home        Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@unique([homeId, name])
  @@map("home_scenes")
  @@schema("max_backend")
}

model HomeNotification {
  id              String             @id @default(uuid()) @db.Uuid
  homeId          String             @map("home_id") @db.Uuid
  userId          String?            @map("user_id") @db.Uuid
  eventId         String?            @map("event_id") @db.Uuid
  message         String
  priority        EventPriority      @default(NORMAL)
  status          NotificationStatus @default(PENDING)
  channel         String
  targetType      String?            @map("target_type")
  targetId        String?            @map("target_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  deliveredAt     DateTime?          @map("delivered_at")
  readAt          DateTime?          @map("read_at")
  acknowledgedAt  DateTime?           @map("acknowledged_at")
  home            Home               @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@index([homeId, createdAt])
  @@index([userId, status])
  @@map("home_notifications")
  @@schema("max_backend")
}

model HomeAccessGrant {
  id          String    @id @default(uuid()) @db.Uuid
  homeId      String    @map("home_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  role        String
  reason      String?
  permissions Json
  roomIds     Json?
  deviceIds   Json?
  startsAt    DateTime  @map("starts_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  home        Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@index([homeId, expiresAt])
  @@map("home_access_grants")
  @@schema("max_backend")
}

model HomeIncident {
  id                 String         @id @default(uuid()) @db.Uuid
  homeId             String         @map("home_id") @db.Uuid
  userId             String?        @map("user_id") @db.Uuid
  type               String
  status             IncidentStatus @default(OPEN)
  priority           EventPriority  @default(CRITICAL)
  message            String
  metadata           Json?
  acknowledgedAt     DateTime?      @map("acknowledged_at")
  resolvedAt         DateTime?      @map("resolved_at")
  cancelledAt        DateTime?      @map("cancelled_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  home               Home            @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@index([homeId, status, createdAt])
  @@map("home_incidents")
  @@schema("max_backend")
}

model HomeLocation {
  id          String   @id @default(uuid()) @db.Uuid
  homeId      String   @map("home_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  latitude    Float
  longitude   Float
  accuracy    Float?
  battery     Int?
  source      String?
  recordedAt  DateTime @default(now()) @map("recorded_at")
  home        Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@index([homeId, userId, recordedAt])
  @@map("home_locations")
  @@schema("max_backend")
}

model HomeGeofence {
  id          String   @id @default(uuid()) @db.Uuid
  homeId      String   @map("home_id") @db.Uuid
  name        String
  latitude    Float
  longitude   Float
  radiusM     Int      @map("radius_m")
  enabled     Boolean  @default(true)
  actions     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  home        Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@index([homeId, enabled])
  @@map("home_geofences")
  @@schema("max_backend")
}

model HomeIntegration {
  id            String   @id @default(uuid()) @db.Uuid
  homeId        String   @map("home_id") @db.Uuid
  provider      String
  status        String
  externalId    String?  @map("external_id")
  capabilities  Json?
  metadata      Json?
  connectedAt   DateTime @default(now()) @map("connected_at")
  lastCheckedAt DateTime? @map("last_checked_at")
  home          Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@unique([homeId, provider, externalId])
  @@index([homeId, status])
  @@map("home_integrations")
  @@schema("max_backend")
}

model HomeHealthIssue {
  id          String   @id @default(uuid()) @db.Uuid
  homeId      String   @map("home_id") @db.Uuid
  severity    EventPriority
  code        String
  title       String
  description String
  resourceType String? @map("resource_type")
  resourceId   String? @map("resource_id")
  recommended Json?
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")
  home        Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@index([homeId, severity, resolvedAt])
  @@map("home_health_issues")
  @@schema("max_backend")
}

model HomeEnergyReading {
  id          String   @id @default(uuid()) @db.Uuid
  homeId      String   @map("home_id") @db.Uuid
  deviceId    String?  @map("device_id") @db.Uuid
  watts       Float?
  kwh         Float?
  voltage     Float?
  recordedAt  DateTime @default(now()) @map("recorded_at")
  home        Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@index([homeId, recordedAt])
  @@index([deviceId, recordedAt])
  @@map("home_energy_readings")
  @@schema("max_backend")
}

model HomeTask {
  id          String   @id @default(uuid()) @db.Uuid
  homeId      String   @map("home_id") @db.Uuid
  title       String
  assignedTo  String?  @map("assigned_to") @db.Uuid
  status      String   @default("pending")
  dueAt       DateTime? @map("due_at")
  completedAt DateTime? @map("completed_at")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  home        Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@index([homeId, status, dueAt])
  @@map("home_tasks")
  @@schema("max_backend")
}

model HomeCalendarEvent {
  id          String   @id @default(uuid()) @db.Uuid
  homeId      String   @map("home_id") @db.Uuid
  title       String
  description String?
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  createdBy   String?  @map("created_by") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  home        Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@index([homeId, startsAt])
  @@map("home_calendar_events")
  @@schema("max_backend")
}

model HomePayment {
  id             String   @id @default(uuid()) @db.Uuid
  homeId         String   @map("home_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  transactionId  String   @unique @map("transaction_id")
  amount         Decimal  @db.Decimal(18,2)
  currency       String
  provider       String
  status         String
  purpose        String?
  providerRef    String?  @map("provider_ref")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  home           Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@index([homeId, status, createdAt])
  @@map("home_payments")
  @@schema("max_backend")
}

model HomeSubscription {
  id          String   @id @default(uuid()) @db.Uuid
  homeId      String   @map("home_id") @db.Uuid
  plan        String
  status      String
  provider    String?
  providerRef String?  @map("provider_ref")
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  metadata    Json?
  home        Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  @@index([homeId, status])
  @@map("home_subscriptions")
  @@schema("max_backend")
}
